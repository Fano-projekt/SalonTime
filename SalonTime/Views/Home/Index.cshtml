@{
    ViewData["Title"] = "Välkommen till SalonTime";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <h1>Välkommen till din skönhetssalong</h1>
        <p>Professionell hårvård och styling i en avslappnande miljö</p>
        <div class="hero-buttons">
            <a href="/Booking/Create" class="btn btn-primary">Boka tid nu</a>
            <a href="/Service" class="btn btn-secondary">Se våra tjänster</a>
        </div>
    </div>
    <div class="hero-image">
        <img src="~/images/imagehembild.jpg" alt="Salong bild">
    </div>
</section>

<!-- Kontaktsektion -->
<section class="contact-section">
    <div class="contact-info">
        <h2>Kontakta oss</h2>
        <p>Vi finns här för dig! Kontakta oss för frågor eller boka direkt online.</p>
        <ul>
            <li> 08-123 456 78</li>
            <li> info@beautysalon.se</li>
            <li> Kungsgatan 1, Stockholm</li>
        </ul>
    </div>

    <div class="opening-hours">
        <h3>Öppettider</h3>
        <table>
            <tr><td>Måndag - Fredag</td><td><strong>10:00 – 19:00</strong></td></tr>
            <tr><td>Lördag</td><td><strong>10:00 – 16:00</strong></td></tr>
            <tr><td>Söndag</td><td><strong>Stängt</strong></td></tr>
        </table>
    </div>
</section>